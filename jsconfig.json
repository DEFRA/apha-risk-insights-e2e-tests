{
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "checkJs": false,
    "paths": {
      "#steps/*": ["./test/steps/*"],
      "#pages/*": ["./test/pages/*"],
      "#api/*": ["./test/api/*"]
    }
  },
  "exclude": [
    "node_modules",
    "playwright-report",
    "test-results",
    ".features-gen",
    "docker"
  ]
}
